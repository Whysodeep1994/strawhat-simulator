{
  "name": "A \"pay one of these\" cost with only one payable option pays it without asking",
  "rules": ["8-3-1-3"],
  "setup": {
    "p1": {
      "hand": ["TEST-ONE-OF-COST", "TEST-TRASHED-DISCOUNT"],
      "don": {
        "active": 2
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.hand.1"]
    }
  ],
  "expect": {
    "p1.leader.rested": false,
    "p1.donActive": 0,
    "p1.donRested": 2,
    "p1.hand": 2,
    "legal.p1.playCard": 0
  }
}
