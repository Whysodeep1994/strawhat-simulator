{
  "name": "Placing a card from your trash at the bottom of your deck as a cost",
  "rules": ["8-3-1"],
  "setup": {
    "p1": {
      "characters": ["TEST-TRASH-TO-DECK"],
      "trash": ["TEST-FILLER", "TEST-C2-3000"],
      "deck": 3,
      "don": {
        "deck": 5
      }
    }
  },
  "actions": [
    {
      "type": "activate",
      "player": "p1",
      "card": "p1.characters.0",
      "effect": 0
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.trash.1"]
    }
  ],
  "expect": {
    "p1.trash": 1,
    "p1.deck": 4,
    "p1.deck.3.cardId": "TEST-C2-3000",
    "p1.donActive": 1
  }
}
