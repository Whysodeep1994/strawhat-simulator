{
  "name": "Add up to 1 matching card from your trash to your hand",
  "rules": ["8-4-4-4"],
  "setup": {
    "p1": {
      "hand": ["TEST-TRASH-TO-HAND"],
      "trash": ["TEST-C4-5000", "TEST-C2-3000"],
      "don": {
        "active": 4
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.trash.0"],
      "illegal": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.trash.1"]
    }
  ],
  "expect": {
    "p1.hand": 1,
    "p1.hand.0.cardId": "TEST-C2-3000",
    "p1.trash": 1
  }
}
