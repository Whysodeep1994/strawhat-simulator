{
  "name": "\"From the top or bottom of your Life cards\": the player can take the bottom card",
  "rules": ["8-3-1", "3-10-2"],
  "setup": {
    "p1": {
      "hand": ["TEST-LIFE-COST-EITHER"],
      "life": ["TEST-FILLER", "TEST-C4-5000"],
      "don": {
        "active": 2,
        "deck": 5
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    }
  ],
  "expect": {
    "p1.life": 1,
    "p1.life.0.cardId": "TEST-FILLER",
    "p1.hand.0.cardId": "TEST-C4-5000",
    "p1.donActive": 1
  }
}
