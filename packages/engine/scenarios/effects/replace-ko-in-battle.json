{
  "name": "A replacement effect with battle: true saves a Character from a K.O. in battle",
  "rules": ["8-1-3-4", "7-1-4-2"],
  "setup": {
    "p1": { "characters": ["TEST-C5-6000"] },
    "p2": {
      "characters": [{ "card": "TEST-SAVE-IN-BATTLE", "rested": true }],
      "hand": ["TEST-FILLER"]
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.characters.0",
      "target": "p2.characters.0"
    },
    { "type": "pass", "player": "p2" },
    { "type": "confirm", "player": "p2", "accept": true }
  ],
  "expect": { "p2.characters": 1, "p2.hand": 0, "p2.trash": 1 }
}
