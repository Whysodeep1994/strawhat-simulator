{
  "name": "Add a Life card to your hand, then a card from your hand to the top of your Life",
  "rules": ["10-2-3"],
  "setup": {
    "p1": {
      "hand": ["TEST-LIFE-SWAP", "TEST-C4-5000"],
      "don": {
        "active": 1
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
