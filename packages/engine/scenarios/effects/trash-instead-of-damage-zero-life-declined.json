{
  "name": "At 0 Life, saying no to \"trash this Character instead\" loses the game",
  "rules": ["8-1-3-4", "7-1-4-1-1-2", "7-1-4-1-1-1"],
  "setup": {
    "p2": {
      "life": 0,
      "characters": ["TEST-TRASH-INSTEAD-OF-DAMAGE"]
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.leader",
      "target": "p2.leader"
    },
    {
      "type": "pass",
      "player": "p2"
    },
    {
      "type": "confirm",
      "player": "p2",
      "accept": false
    }
  ],
  "expect": {
    "winner": "p1",
    "prompt.kind": "gameOver"
  }
}
