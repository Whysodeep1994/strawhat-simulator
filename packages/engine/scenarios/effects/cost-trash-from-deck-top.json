{
  "name": "\"You may trash 2 cards from the top of your deck\" pays from the deck, then checks the opponent's hand",
  "rules": ["8-3-1-3"],
  "setup": {
    "p1": {
      "characters": ["TEST-DECK-TRASH"],
      "deck": 10
    },
    "p2": {
      "hand": [
        "TEST-FILLER",
        "TEST-FILLER",
        "TEST-FILLER",
        "TEST-FILLER",
        "TEST-FILLER",
        "TEST-FILLER",
        "TEST-FILLER"
      ]
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.characters.0",
      "target": "p2.leader"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p2.hand.0"]
    }
