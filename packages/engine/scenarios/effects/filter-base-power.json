{
  "name": "A base power filter reads printed power, not power changed by effects",
  "rules": ["2-6-1", "2-6-3"],
  "setup": {
    "p1": {
      "hand": ["TEST-POWER-DOWN", "TEST-KO-BASE-POWER"]
    },
    "p2": {
      "characters": ["TEST-C4-5000", "TEST-C2-3000"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    },
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
