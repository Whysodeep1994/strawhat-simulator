{
  "name": "\"That Character\" points at the card the previous step picked",
  "rules": ["8-2-1"],
  "setup": {
    "p1": {
      "hand": ["TEST-NEGATE-KO"],
      "don": {
        "active": 1
      }
    },
    "p2": {
      "characters": ["TEST-C4-5000", "TEST-C2-3000"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.1"]
    }
  ],
  "expect": {
    "p2.characters": 1,
    "p2.characters.0.cardId": "TEST-C4-5000"
  }
}
