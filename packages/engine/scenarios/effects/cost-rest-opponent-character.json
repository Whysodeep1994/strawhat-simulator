{
  "name": "\"You may rest 1 of your opponent's Characters instead\" saves the Character",
  "rules": ["8-1-3-4"],
  "setup": {
    "p1": {
      "hand": ["TEST-KO-ANY"],
      "characters": ["TEST-FILLER"]
    },
    "p2": {
      "characters": ["TEST-REST-INSTEAD"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    },
    {
      "type": "confirm",
      "player": "p2",
      "accept": true
    }
  ],
  "expect": {
    "p2.characters": 1,
    "p1.characters.0.rested": true
  }
}
