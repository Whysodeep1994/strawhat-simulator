{
  "name": "\"Activate the [Main] effect of an Event card in your trash\": it resolves and the Event stays in the trash",
  "rules": ["8-4"],
  "setup": {
    "p1": { "hand": ["TEST-EVENT-REPLAY"], "trash": ["TEST-KO-EVENT"], "don": { "active": 1 } },
    "p2": { "characters": ["TEST-FILLER"] }
  },
  "actions": [
    { "type": "playCard", "player": "p1", "card": "p1.hand.0" },
    { "type": "choose", "player": "p1", "cards": ["p1.trash.0"] },
    { "type": "choose", "player": "p1", "cards": ["p2.characters.0"] }
  ],
  "expect": { "p2.characters": 0, "p1.trash": 1, "p1.characters": 1 }
}
