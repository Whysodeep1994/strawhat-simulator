{
  "name": "A [Counter] event changes the attack target to one of your Characters",
  "rules": ["7-1-3-1-2"],
  "setup": {
    "p2": {
      "characters": ["TEST-C2-3000"],
      "hand": ["TEST-REDIRECT"]
  "name": "Turning a face-up Life card face-down changes the target of the attack",
  "rules": ["8-3-1-3"],
  "setup": {
    "p1": {
      "characters": ["TEST-C5-6000"]
    },
    "p2": {
      "characters": ["TEST-REDIRECT", "TEST-C5-6000"],
      "life": 2,
      "lifeFaceUp": 1
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.leader",
      "target": "p2.leader"
    },
    {
      "type": "counterEvent",
      "player": "p2",
      "card": "p2.hand.0"
      "attacker": "p1.characters.0",
      "target": "p2.leader"
    },
    {
      "type": "confirm",
      "player": "p2",
      "accept": true
    },
    {
      "type": "pass",
      "player": "p2"
    }
  ],
  "expect": {
    "p2.characters": 0,
    "p2.life": 4
    "p2.life": 2,
    "p2.life.0.faceUp": false,
    "p2.characters": 1
  }
