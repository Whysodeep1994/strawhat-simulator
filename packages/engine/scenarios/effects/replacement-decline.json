{
  "name": "Declining a replacement effect lets the K.O. happen",
  "rules": ["8-1-3-4-1"],
  "setup": {
    "p1": {
      "hand": ["TEST-KO-ANY"]
    },
    "p2": {
      "characters": ["TEST-PROTECTED", "TEST-BODYGUARD"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    },
    {
      "type": "confirm",
      "player": "p2",
      "accept": false
    }
  ],
  "expect": {
    "p2.characters": 1,
    "p2.characters.0.cardId": "TEST-BODYGUARD",
    "p2.trash": 1
  }
}
