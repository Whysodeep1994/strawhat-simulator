{
  "name": "Put your opponent's Life cards back in any order, then turn your Life cards face-down",
  "rules": ["4-11"],
  "setup": {
    "p1": {
      "hand": ["TEST-LIFE-ORDER"]
    },
    "p2": {
      "life": ["TEST-C2-3000", "TEST-C4-5000"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.life.1", "p2.life.0"]
    }
  ],
  "expect": {
    "p2.life.0.cardId": "TEST-C4-5000",
    "p2.life.1.cardId": "TEST-C2-3000",
    "p1.life.0.faceUp": false
  }
}
