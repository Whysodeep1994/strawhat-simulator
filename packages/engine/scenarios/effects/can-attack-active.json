{
  "name": "\"Can also attack your opponent's active Characters\"",
  "rules": ["7-1-1-1", "7-1-1-2"],
  "setup": {
    "p1": {
      "characters": ["TEST-ATTACK-ACTIVE", "TEST-FILLER"]
    },
    "p2": {
      "characters": ["TEST-FILLER"]
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.characters.1",
      "target": "p2.characters.0",
      "illegal": true
    },
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.characters.0",
      "target": "p2.characters.0"
    },
    { "type": "pass", "player": "p2" }
  ],
  "expect": {
    "p2.characters": 0,
    "p2.trash": 1
  }
}
