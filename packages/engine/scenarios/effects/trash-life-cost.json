    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    }
  ],
  "expect": {
    "p1.life": 1,
    "p1.trash": 2,
    "p1.trash.0.cardId": "TEST-C2-3000",
    "p1.hand": 2
  }
