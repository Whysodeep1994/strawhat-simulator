{
  "name": "Trashing the top Life card as a cost",
  "rules": ["8-3-1", "3-10-2"],
  "setup": {
    "p1": {
      "hand": ["TEST-TRASH-LIFE-COST"],
      "life": ["TEST-C2-3000", "TEST-FILLER"],
      "don": {
        "active": 1
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
