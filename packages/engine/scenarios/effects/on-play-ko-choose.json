{
  "name": "An 'up to 1' K.O. asks the player to choose, and only matching cards are options",
  "rules": ["10-2-1-2", "4-8", "4-8-1", "8-4-4", "8-4-4-1", "1-3-5-1"],
  "setup": {
    "p1": {
      "hand": ["TEST-ONPLAY-KO"],
      "don": {
        "active": 4
      }
    },
    "p2": {
      "characters": ["TEST-C2-3000", "TEST-C5-6000"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.1"],
      "illegal": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    }
  ],
  "expect": {
    "p2.characters": 1,
    "p2.characters.0.cardId": "TEST-C5-6000",
    "p2.trash": 1
  }
}
