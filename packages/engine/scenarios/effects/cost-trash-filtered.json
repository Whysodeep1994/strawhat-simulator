{
  "name": "A filtered trash cost can only trash matching cards",
  "rules": ["8-3-1", "8-3-1-3"],
  "setup": {
    "p1": {
      "characters": ["TEST-TRASH-CREW-COST"],
      "hand": ["TEST-FILLER", "TEST-C2-3000"]
    }
  },
  "actions": [
    {
      "type": "activate",
      "player": "p1",
      "card": "p1.characters.0",
      "effect": 0
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    }
  ],
  "expect": {
    "p1.hand": 3,
    "p1.trash": 1,
    "p1.trash.0.cardId": "TEST-C2-3000"
  }
}
