{
  "name": "Give 1 active DON!! to a named card, then give that card +2000 power",
  "rules": ["8-1-3-1"],
  "setup": {
    "p1": {
      "characters": ["TEST-GIVE-DON-NAMED", "TEST-FILLER"],
      "don": {
        "active": 1
      }
    }
  },
  "actions": [
    {
      "type": "activate",
