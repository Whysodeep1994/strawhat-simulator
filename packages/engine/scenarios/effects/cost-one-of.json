    "p1": {
      "leader": "TEST-LEADER-SLASH",
      "hand": ["TEST-ONE-OF-COST", "TEST-TRASHED-DISCOUNT"],
      "don": {
        "active": 4
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "chooseOne",
      "player": "p1",
