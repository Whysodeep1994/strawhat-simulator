    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.hand.1"]
    },
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    }
  ],
  "expect": {
    "p1.leader.rested": true,
    "p1.characters": 2,
    "p1.donActive": 0,
    "p1.trash": 1
