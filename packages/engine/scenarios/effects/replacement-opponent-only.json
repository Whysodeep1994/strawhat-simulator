{
  "name": "\"Removed by your opponent's effect ... trash 1 card from your hand instead\", once per turn",
  "rules": ["8-1-3-4", "10-2-13"],
  "setup": {
    "p1": {
      "hand": ["TEST-KO-ANY", "TEST-KO-ANY"]
    },
    "p2": {
      "characters": ["TEST-HAND-SHIELD"],
      "hand": ["TEST-FILLER", "TEST-FILLER"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    },
    {
      "type": "confirm",
      "player": "p2",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p2.hand.0"]
    },
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    }
  ],
  "expect": {
    "p2.characters": 0,
    "p2.hand": 1,
    "p2.trash": 2
  }
}
