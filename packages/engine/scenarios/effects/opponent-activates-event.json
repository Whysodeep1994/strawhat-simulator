{
  "name": "When your opponent activates an Event, they place a card from hand at the bottom of their deck",
  "rules": ["8-1-3-1"],
  "setup": {
    "p1": {
      "characters": ["TEST-EVENT-WATCHER"]
    },
    "p2": {
      "hand": ["TEST-EVENT-COUNTER", "TEST-FILLER"],
      "don": {
        "active": 1
      }
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.leader",
      "target": "p2.leader"
    },
    {
      "type": "counterEvent",
      "player": "p2",
      "card": "p2.hand.0"
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p2.leader"]
    },
    {
      "type": "pass",
      "player": "p2"
    }
  ],
  "expect": {
    "p2.life": 4,
    "p2.hand": 0,
    "p2.deck": 21
  }
}
