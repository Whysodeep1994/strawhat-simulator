{
  "name": "K.O.ing a Character in battle triggers \"when this Character battles and K.O.'s\"",
  "rules": [
    "8-1-3-1"
  ],
  "setup": {
    "p1": {
      "characters": [
        "TEST-BATTLE-KO"
      ]
    },
    "p2": {
      "characters": [
        {
          "card": "TEST-FILLER",
          "rested": true
        }
      ]
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.characters.0",
      "target": "p2.characters.0"
    },
    {
      "type": "pass",
      "player": "p2"
    }
  ],
  "expect": {
    "p2.characters": 0,
    "p1.characters.0.rested": false
  }
}
