{
  "name": "Playing a 6th Character trashes one already in play",
  "rules": ["3-7-6", "3-7-6-1"],
  "setup": {
    "p1": {
      "characters": ["TEST-FILLER", "TEST-FILLER", "TEST-FILLER", "TEST-FILLER", "TEST-FILLER"],
      "hand": ["TEST-C2-3000"],
      "don": {
        "active": 2
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0",
      "illegal": true
    },
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0",
      "trash": "p1.characters.2"
    }
  ],
  "expect": {
    "p1.characters": 5,
    "p1.trash": 1,
    "p1.characters.4.cardId": "TEST-C2-3000"
  }
}
