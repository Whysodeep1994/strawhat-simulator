{
  "name": "Beating a rested Character K.O.s it into its owner's trash",
  "rules": ["7-1-4-1-2", "10-2-1", "10-2-1-1", "10-2-1-2", "3-5-1", "4-2-1", "4-2-1-1"],
  "setup": {
    "p1": {
      "characters": ["TEST-C4-5000"]
    },
    "p2": {
      "characters": [
        {
          "card": "TEST-C2-3000",
          "rested": true
        }
      ]
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.characters.0",
